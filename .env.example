# CraftForge — variáveis de ambiente (copie para .env.local)

# URL pública do site. Usada nos links de e-mail e no metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Onde o datastore SQLite fica. Padrão: ./data/craftforge.db
# Use ":memory:" para um banco volátil (útil em testes).
# CRAFTFORGE_DB=./data/craftforge.db

# Intervalo (ms) entre flushes do banco para disco. Padrão: 250
# CRAFTFORGE_FLUSH_MS=250

# Defina como "off" para silenciar o log de e-mails no console.
# CRAFTFORGE_MAIL_LOG=on

# Hosts extras liberados na checagem de Origin (CSRF), separados por vírgula.
# Necessário apenas se o site for acessado por mais de um domínio.
# ALLOWED_ORIGINS=https://craftforge.com,https://www.craftforge.com

# Entrega de e-mail em produção.
# O transporte padrão grava as mensagens na caixa de saída interna (/caixa-de-entrada).
# Para enviar de verdade, implemente o transporte em src/lib/mailer.ts com
# Resend / Amazon SES / Postmark / SMTP e defina a credencial aqui.
# SMTP_URL=
# RESEND_API_KEY=
