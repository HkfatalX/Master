{
  "name": "craftforge",
  "version": "1.0.0",
  "private": true,
  "description": "CraftForge \u2014 criador de addons, mods, mundos e texturas para Minecraft Bedrock direto no navegador.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
